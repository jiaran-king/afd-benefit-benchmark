# Copy outside the repository, replace every path, and source the actual CANN environment first.
# These are deployment locations, not changes to model/performance parameters.
export BENEFIT_PYTHON=/path/to/python3.12
export MODEL_DIR=/path/to/frozen-w4a8-model
export VLLM_SOURCE_DIR=/path/to/vllm-d02df748
export ASCEND_SOURCE_DIR=/path/to/ascend-with-patches-and-corrected-host
export FFN_ASCEND_SOURCE_DIR=/path/to/original-ascend-runtime-for-ffn
export AFD_SOURCE_DIR=/path/to/afd-cda849a-with-matching-native-ops
# Optional only when hostname resolution is not the intended communication address:
# export BENCH_HCCL_IF_IP=<local communication interface IPv4>
# The frozen environment uses eth0; another interface is a recorded deployment change.
export OMP_NUM_THREADS=4
export PYTHONHASHSEED=7
export TASK_QUEUE_ENABLE=1
export PYTORCH_NPU_ALLOC_CONF=expandable_segments:True
unset HCCL_DETERMINISTIC
