+def get_compressor_checkpoint_budget_ratio(
+    additional_config: dict[str, Any] | None,
+) -> float:
+    """Validate the optional allocator-page budget; it does not preallocate pages."""
+    value = (additional_config or {}).get(
+        "compressor_checkpoint_budget_ratio", DEFAULT_COMPRESSOR_CHECKPOINT_BUDGET_RATIO
+    )
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ValueError("compressor_checkpoint_budget_ratio must be a finite number strictly between 0 and 1")
+    if not 0 < value < 1 or not math.isfinite(value):
+        raise ValueError("compressor_checkpoint_budget_ratio must be a finite number strictly between 0 and 1")
+    return float(value)
 
 
